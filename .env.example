# Firebase web configuration (safe to expose through /api/config)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin service account JSON, stored as one Vercel secret value
FIREBASE_SERVICE_ACCOUNT_JSON=

# Stripe test-mode first. Switch all three together when moving to live mode.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
